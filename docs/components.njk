---
pagination:
  data: components
  size: 1
  alias: component
layout: default.njk
section: components
permalink: "/components/{{ component.name }}/"
eleventyComputed:
  title: "{{ component.label or component.title }}"
---

<article{% if component.wide %} class="wide"{% endif %}>
  <style>
    @scope {
      :scope {
        padding: 2rem;
        display: grid;
        gap: 1rem;
        grid-template:
          "header aside" auto
          "article-body aside" 1fr / minmax(0, max-content) max-content;
        max-width: 1080px;
        &.wide {
          max-width: 100%;
        }
      }
      header {
        grid-area: header;
      }
      .article-body {
        grid-area: article-body;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      aside {
        grid-area: aside;
        position: sticky;
        top: calc(var(--top-height) + 2rem);
        max-height: calc(100vh - var(--top-height) - 4rem);
        overflow-y: auto;
      }
      @media (max-width: 767px) {
        :scope {
          padding: 1rem;
          max-width: 100%;
          grid-template:
            "aside" auto
            "header" auto
            "article-body" 1fr / minmax(0, max-content);
        }
        aside {
          position: static;
          max-height: none;
        }
      }
    }
  </style>
  <header>
    <h1>{{ component.label }}</h1>
    <orb-color light="neutral-750" dark="neutral">{{ component.title }}</orb-color>
  </header>
  <div class="article-body">
    {{ component.content | markdown | safe }}
  </div>
  {% set toc = component.content | toc %}
  {% if toc %}
  <aside>
    <orb-layout-swap breakpoint="767">
      <div slot="desktop">{{ toc | safe }}</div>
      <orb-details slot="mobile" summary="Table of Contents" class="orb-margin-bottom">
        {{ toc | safe }}
      </orb-details>
    </orb-layout-swap>
  </aside>
  {% endif %}
</article>
