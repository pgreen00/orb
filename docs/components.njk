---
pagination:
  data: components
  size: 1
  alias: component
layout: default.njk
permalink: "/components/{{ component.name }}/"
eleventyComputed:
  title: "{{ component.label or component.title }}"
---

<article>
  <style>
    @scope {
      header {
        padding: 2rem 4rem;
      }
      .article-grid {
        display: flex;
        flex-wrap: wrap-reverse;
        align-items: baseline;
        gap: 2rem;
        padding-inline: 4rem;
        padding-bottom: 2rem;
      }
      .article-body {
        max-width: 800px;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        flex: 1 1 0;
      }
      aside {
        min-width: 200px;
        position: sticky;
        top: calc(var(--top-height) + 4rem);
        height: fit-content;
      }
      @media (max-width: 767px) {
        aside {
          display: none;
        }
      }
    }
  </style>
  <header>
    <h1>{{ component.label }}</h1>
    <orb-color light="neutral-750" dark="neutral">{{ component.title }}</orb-color>
  </header>
  <div class="article-grid">
    <div class="article-body">
      {{ component.content | markdown | safe }}
    </div>
    <aside>
      <orb-toc></orb-toc>
    </aside>
  </div>
</article>
