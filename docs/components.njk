---
pagination:
  data: components
  size: 1
  alias: component
layout: default.njk
permalink: "/components/{{ component.name }}/"
eleventyComputed:
  title: "{{ component.title }}"
---

<orb-view label="{{ component.title }}">
  <orb-mi slot="actions">Something to do</orb-mi>
  <orb-mi slot="actions">Something else</orb-mi>
  {{ component.content | markdown | safe }}
</orb-view>
