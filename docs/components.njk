---
pagination:
  data: components
  size: 1
  alias: component
layout: default.njk
permalink: "/components/{{ component.name }}/"
eleventyComputed:
  title: "{{ component.title }}"
---

<article>
  <style>
    @scope {
      :scope {
        padding: 4rem;
      }
      .article-grid {
        display: flex;
        flex-wrap: wrap-reverse;
        align-items: baseline;
        gap: 2rem;
      }
      .article-body {
        max-width: 800px;
        min-width: 0;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }
      aside {
        flex: 1;
        min-width: 200px;
        position: sticky;
        top: calc(var(--top-height) + 4rem);
        height: fit-content;
      }
    }
  </style>
  <header>
    <h1>{{ component.title }}</h1>
  </header>
  <div class="article-grid">
    <div class="article-body">
      {{ component.content | markdown | safe }}
    </div>
    <aside>
      <orb-toc></orb-toc>
    </aside>
  </div>
</article>
