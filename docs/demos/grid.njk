---
pagination:
  data: employees
  size: 10
  alias: employees
  permalink: "/demos/grid/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}"
layout: false
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/hex-tag.svg" />
  <meta
    name="viewport"
    content="width=device-width, user-scalable=no"
  />
  <title>Orb Design System</title>
  <style>@view-transition {navigation: auto;}</style>
  <script type="module">
    const t = localStorage.getItem('orb__theme') || 'system'
    const el = document.documentElement
    el.classList.toggle('orb-theme-light', t === 'light')
    el.classList.toggle('orb-theme-dark', t === 'dark')
  </script>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/build/styles/index.css" />
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"></script>
  <script type="importmap">
    {
      "imports": {
        "orb-style": "/build/components/index.js",
        "orb-style/": "/build/components/"
      }
    }
  </script>
  <script type="module" src="/build/loader.js"></script>
</head>

<body>
  <header>
    <orb-toolbar>
      <a class="banner-title orb-font-semi-bold" href="/">
        <img src="/hex-tag.svg" alt="logo" height="42" width="42" />
        <span class="orb-margin-left-xs">Orb Design System</span>
      </a>
      <orb-button class="icon-only" fill="clear" size="lg" slot="end">
        <iconify-icon height="2rem" width="2rem" icon="mdi:search"></iconify-icon>
      </orb-button>
      <a href="https://github.com/pgreen00/orb" target="_blank" slot="end">
        <iconify-icon height="2.5rem" width="2.5rem" icon="akar-icons:github-fill"></iconify-icon>
      </a>
      <orb-popover slot="end" placement="bottom-end" show-on="hover">
        <orb-button class="icon-only" slot="trigger" size="lg">
          <iconify-icon height="1.5rem" width="1.5rem" icon="mdi:moon-and-stars"></iconify-icon>
        </orb-button>
        <orb-menu id="theme-menu">
          <orb-mi value="system">
            <iconify-icon slot="icon" icon="mdi:moon-and-stars"></iconify-icon>
            System
          </orb-mi>
          <orb-mi value="light">
            <iconify-icon slot="icon" icon="material-symbols:light-mode"></iconify-icon>
            Light
          </orb-mi>
          <orb-mi value="dark">
            <iconify-icon slot="icon" icon="material-symbols:dark-mode"></iconify-icon>
            Dark
          </orb-mi>
        </orb-menu>
      </orb-popover>
    </orb-toolbar>
  </header>
  <main class="orb-padding">
    <orb-grid borders="cols" selection="single">
      <orb-gr section="head">
        <orb-gc field="id" sticky sortable>ID</orb-gc>
        <orb-gc field="name" sortable>Name</orb-gc>
        <orb-gc field="department" sortable>Department</orb-gc>
        <orb-gc field="position">Position</orb-gc>
        <orb-gc field="salary" sortable>Salary</orb-gc>
        <orb-gc field="status">Status</orb-gc>
      </orb-gr>
      {% for e in employees %}
        <orb-gr>
          <orb-gc field="id">{{ e.id }}</orb-gc>
          <orb-gc field="name">{{ e.name }}</orb-gc>
          <orb-gc field="department">{{ e.dept }}</orb-gc>
          <orb-gc field="position">{{ e.role }}</orb-gc>
          <orb-gc field="salary">{{ e.salary }}</orb-gc>
          <orb-gc field="status">{{ e.status }}</orb-gc>
        </orb-gr>
      {% endfor %}
    </orb-grid>
  </main>
</body>

<script type="module">
  async function setTheme(theme) {
    const htmlEl = document.querySelector('html')
    localStorage.setItem('orb__theme', theme ?? 'system')
    htmlEl.classList.toggle('orb-theme-light', theme === 'light')
    htmlEl.classList.toggle('orb-theme-dark', theme === 'dark')
    const menuItems = Array.from(document.querySelectorAll('#theme-menu > orb-mi'))
    await customElements.whenDefined('orb-mi')
    for (const item of menuItems) {
      item.checked = theme == item.value
    }
  }
  setTheme(localStorage.getItem('orb__theme'))
  const themeMenu = document.querySelector('#theme-menu')
  themeMenu.addEventListener('orbAction', ev => {
    setTheme(ev.detail.value)
  })
</script>

</html>
