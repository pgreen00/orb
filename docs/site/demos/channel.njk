---
layout: false
permalink: "/demos/channel/"
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/orb.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Channel test page | Orb</title>
  <script type="module">
    const t = localStorage.getItem('orb__theme') || 'system'
    const el = document.documentElement
    el.classList.toggle('orb-theme-light', t === 'light')
    el.classList.toggle('orb-theme-dark', t === 'dark')
  </script>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/build/orb.css" />
  <script type="module" src="/build/loader.js"></script>
  <style>
    .page {
      display: flex;
      flex-direction: column;
      gap: var(--orb-spacing-lg);
      padding: var(--orb-spacing-lg);
    }

    .settings {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--orb-spacing-md);
    }

    .cards {
      inline-size: 100%;
    }

    .card {
      display: flex;
      flex-direction: column;
      gap: var(--orb-spacing-sm);
      min-width: 0;
      padding-block: var(--orb-spacing-md);
    }

    .card p,
    .card li {
      color: var(--orb-note-color);
      font-size: var(--orb-font-sm);
    }

    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--orb-spacing-sm);
    }

    .row label {
      display: inline-flex;
      align-items: center;
      gap: var(--orb-spacing-2xs);
      font-size: var(--orb-font-sm);
    }

    .slot orb-channel {
      display: flex;
      block-size: 750px;
    }

    .readout {
      font-variant-numeric: tabular-nums;
    }

    .try {
      margin: 0;
      padding-inline-start: var(--orb-spacing-md);
    }

    .log {
      display: flex;
      flex-direction: column;
      gap: var(--orb-spacing-sm);
    }

    .log ol {
      display: flex;
      flex-direction: column;
      gap: var(--orb-spacing-2xs);
      max-block-size: 24rem;
      margin: 0;
      padding: var(--orb-spacing-sm);
      overflow-y: auto;
      border: 1px solid var(--orb-divider-color);
      border-radius: var(--orb-radius-md);
      list-style: none;
      font-family: var(--orb-font-mono, ui-monospace, monospace);
      font-size: var(--orb-font-xs);
    }

    .log li[data-kind="cancel"] {
      color: var(--orb-danger-500);
    }
  </style>
</head>

<body>
  <main class="page">
    <header>
      <h1>Channel test page</h1>
      <p>
        Every feature of <code>orb-channel</code>, in one place. Each card is a conversation with a checklist of things to try.
        Simulate buttons add messages the way a server would. Every event the channels emit is written to the log at the bottom.
      </p>
      <div class="settings">
        <label><input type="checkbox" id="cancel-short"> Cancel sends under 5 characters</label>
        <label><input type="checkbox" id="keep-edit"> Keep the editor open on save</label>
        <label><input type="checkbox" id="keep-deleted"> Keep deleted messages</label>
        <span>Reads seen: <span id="read-count">0</span></span>
      </div>
      <div class="row">
        <button type="button" data-reset-all>Reset all</button>
      </div>
    </header>

    <orb-tabs wrap class="cards">
      <orb-tab-button panel="direct">1. Direct chat</orb-tab-button>
      <orb-tab-button panel="group">2. Group chat</orb-tab-button>
      <orb-tab-button panel="open">3. Open channel</orb-tab-button>
      <orb-tab-button panel="moderation">4. Comments and moderation</orb-tab-button>
      <orb-tab-button panel="rich">5. Rich composer and commands</orb-tab-button>
      <orb-tab-button panel="limits">6. Slow mode and mute</orb-tab-button>
      <orb-tab-button panel="plain">7. Plain composer, files and form</orb-tab-button>
      <orb-tab-button panel="bare">8. Empty state, no header</orb-tab-button>
      <orb-tab-button panel="ai">9. AI participant</orb-tab-button>
      <orb-tab-button panel="threads">10. Threads, long lists and presence</orb-tab-button>
      <orb-tab-button panel="transports">11. Transports and drafts</orb-tab-button>

      <orb-tab-panel name="direct">
        <div class="card" data-card="direct">
        <p>Messages, markdown, HTML, reactions, mentions, links, an attachment, and echo.</p>
        <div class="row">
          <label>Point of view
            <select data-attr="pov">
              <option value="ada">Ada</option>
              <option value="grace">Grace</option>
            </select>
          </label>
          <label>Kind
            <select data-attr="kind">
              <option value="">default</option>
              <option value="direct">direct</option>
              <option value="group">group</option>
              <option value="open">open</option>
            </select>
          </label>
          <label>Echo
            <select data-attr="echo" data-tri>
              <option value="default">default</option>
              <option value="on">on</option>
              <option value="off">off</option>
            </select>
          </label>
          <label>Names
            <select data-attr="show-names" data-tri>
              <option value="default">default</option>
              <option value="on">on</option>
              <option value="off">off</option>
            </select>
          </label>
          <label>Avatars
            <select data-attr="avatars" data-tri>
              <option value="default">default</option>
              <option value="on">on</option>
              <option value="off">off</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="direct-grace">Grace sends a message</button>
          <button type="button" data-simulate="direct-reaction">Grace reacts 👍 to Ada's last message</button>
          <button type="button" data-simulate="direct-link">Grace sends a link</button>
          <button type="button" data-reset="direct">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="direct"></div>
        <ul class="try">
          <li>Type a message and press Enter. It appears as Ada, because echo is on.</li>
          <li>Press Shift+Enter to add a line without sending.</li>
          <li>Right-click a message (or press and hold it on a touch screen). Try the reactions, Reply, Copy, Edit and Delete on Ada's messages, and Report on Grace's.</li>
          <li>Click the 🎉 reaction to toggle yours. Then switch the point of view to Grace.</li>
          <li>Type <code>@Ada</code> or follow the link. The mention is highlighted for Ada only.</li>
          <li>Set Kind to <code>group</code> and see names and avatars appear.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="group">
        <div class="card" data-card="group">
        <p>Names, grouping, date dividers, an unread divider, and attachments on the composer.</p>
        <div class="row">
          <label>Point of view
            <select data-attr="pov">
              <option value="ada">Ada</option>
              <option value="grace">Grace</option>
              <option value="lin">Lin</option>
            </select>
          </label>
          <label>Kind
            <select data-attr="kind">
              <option value="">default</option>
              <option value="direct">direct</option>
              <option value="group">group</option>
              <option value="open">open</option>
            </select>
          </label>
          <label>Group within
            <select data-attr="group-within">
              <option value="">default</option>
              <option value="0">0 (off)</option>
              <option value="1m">1m</option>
              <option value="5m">5m</option>
            </select>
          </label>
          <label>Date dividers
            <select data-attr="date-dividers" data-tri>
              <option value="default">default</option>
              <option value="on">on</option>
              <option value="off">off</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="group-lin">Lin sends a message</button>
          <button type="button" data-simulate="group-unread">Mark unread from the last message</button>
          <button type="button" data-simulate="group-tomorrow">Grace sends one tomorrow</button>
          <button type="button" data-reset="group">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="group"></div>
        <ul class="try">
          <li>Messages from the same sender within 5 minutes are grouped. Set Group within to 1m and watch the groups split.</li>
          <li>Click "Mark unread from the last message". The readout's unread count rises with each new message from someone else.</li>
          <li>Click "Grace sends one tomorrow". A date divider appears.</li>
          <li>Attach a file with the paperclip, then send. Only images and PDFs are accepted.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="open">
        <div class="card" data-card="open">
        <p>A header with a label and description, a long list to scroll, and the composer methods.</p>
        <div class="row">
          <label>Kind
            <select data-attr="kind">
              <option value="">default</option>
              <option value="direct">direct</option>
              <option value="group">group</option>
              <option value="open">open</option>
            </select>
          </label>
          <label>Header
            <select data-attr="show-header" data-tri>
              <option value="default">default (shown)</option>
              <option value="on">shown</option>
              <option value="off">hidden</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="open-batch">Add 20 messages</button>
          <button type="button" data-simulate="open-jump">Jump to the first message</button>
          <button type="button" data-simulate="open-focus">Focus the composer</button>
          <button type="button" data-simulate="open-send">Send from code with send()</button>
          <button type="button" data-reset="open">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="open"></div>
        <ul class="try">
          <li>Scroll to the top, then click "Add 20 messages". The list stays where you are.</li>
          <li>Scroll to the bottom. New messages keep it there.</li>
          <li>"Jump to the first message" scrolls to it. Tab and the arrow keys move between messages.</li>
          <li>Hide the header, then show it again.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="moderation">
        <div class="card" data-card="moderation">
        <p>Hidden, removed and pending messages, an ignored participant, and moderator buttons.</p>
        <div class="row">
          <label>Point of view
            <select data-attr="pov">
              <option value="mod">Mod (moderator)</option>
              <option value="ada">Ada</option>
              <option value="grace">Grace</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="moderation-troll">Troll posts</button>
          <button type="button" data-simulate="moderation-pending">Grace posts a pending comment</button>
          <button type="button" data-reset="moderation">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="moderation"></div>
        <ul class="try">
          <li>As Mod, right-click a message. Try Pin, Hide, Remove and Mute. Pin and Hide also change the message.</li>
          <li>Click "Show anyway" on the hidden comment and on Troll's comment.</li>
          <li>Switch the point of view to Grace. The moderator buttons disappear, and the removed comment says so.</li>
          <li>Press Ctrl or ⌘+Enter to send. Enter adds a line.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="rich">
        <div class="card" data-card="rich">
        <p>The rich editor, with its formatting toolbar, mentions and commands.</p>
        <div class="row">
          <label>Point of view
            <select data-attr="pov">
              <option value="ada">Ada</option>
              <option value="grace">Grace</option>
              <option value="lin">Lin</option>
            </select>
          </label>
          <label>Echo
            <select data-attr="echo" data-tri>
              <option value="default">default</option>
              <option value="on">on</option>
              <option value="off">off</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="rich-send">Send from code with send()</button>
          <button type="button" data-reset="rich">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="rich"></div>
        <ul class="try">
          <li>Type <code>/</code> at the start of a line. Pick Summarize, type some text, then press Enter.</li>
          <li>Type <code>@</code> and pick a person. Check the log for the mentions.</li>
          <li>Click Aa to show the toolbar, and make some text bold. Click Aa again to hide it.</li>
          <li>Press Enter on an empty box. Nothing is sent.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="limits">
        <div class="card" data-card="limits">
        <p>Slow mode holds back each message. A muted point of view can't write.</p>
        <div class="row">
          <label>Slow mode
            <select data-attr="slow-mode">
              <option value="">off</option>
              <option value="5s">5 seconds</option>
              <option value="15s">15 seconds</option>
              <option value="1m">1 minute</option>
            </select>
          </label>
          <label>Point of view
            <select data-attr="pov">
              <option value="ada">Ada</option>
              <option value="grace">Grace</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-mute="ada">Mute or unmute Ada</button>
          <button type="button" data-reset="limits">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="limits"></div>
        <ul class="try">
          <li>Set slow mode to 15 seconds. Send a message, then try again. The countdown shows until you can send.</li>
          <li>Click "Mute or unmute Ada". The composer is disabled, and says why.</li>
          <li>Switch the point of view to Grace. Slow mode and mute don't apply to Grace's own messages.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="plain">
        <div class="card" data-card="plain">
        <p>Attachments, composer buttons, a 200-character limit, and the channel inside a form.</p>
        <div class="row">
          <label>Send on
            <select data-attr="send-on" data-on="orb-channel-composer">
              <option value="">default</option>
              <option value="enter">Enter</option>
              <option value="mod-enter">Ctrl or ⌘+Enter</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-formdata>Show the form data</button>
          <button type="button" data-reset="plain">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="plain"></div>
        <ul class="try">
          <li>Attach a file, or drag one onto the box, or paste an image. The attached files show above the box.</li>
          <li>Click the GIF and poll buttons. The log shows which one was clicked.</li>
          <li>Type past 200 characters. The box stops at 200.</li>
          <li>Click "Show the form data" after you've typed something. The draft is in the form, under <code>body</code>.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="bare">
        <div class="card" data-card="bare">
        <p>An empty channel with the header hidden.</p>
        <div class="row">
          <button type="button" data-simulate="bare-ada">Ada writes the first message</button>
          <button type="button" data-reset="bare">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="bare"></div>
        <ul class="try">
          <li>The empty text shows until the first message.</li>
          <li>Send a message. Once there's one, the empty text goes away.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="ai">
        <div class="card" data-card="ai">
        <p>Claude streams its answers. The send button becomes a stop button while it streams. Reasoning, a tool call that needs approval, citations, suggestions and versions are here too.</p>
        <div class="row">
          <label>Reasoning
            <select data-attr="reasoning">
              <option value="collapsed">collapsed</option>
              <option value="show">show</option>
              <option value="hidden">hidden</option>
            </select>
          </label>
          <label>While streaming
            <select data-attr="while-streaming" data-on="orb-channel-composer">
              <option value="block">block</option>
              <option value="queue">queue</option>
              <option value="interrupt">interrupt</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="ai-approval">Claude asks to delete a branch</button>
          <button type="button" data-simulate="ai-write">Claude writes an answer</button>
          <button type="button" data-reset="ai">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="ai"></div>
        <ul class="try">
          <li>Send a message. Claude answers, and the send button becomes a stop button while it streams. Press it to stop.</li>
          <li>Send again while it streams. With <em>block</em>, nothing happens. With <em>queue</em>, the draft waits for the answer. With <em>interrupt</em>, the answer stops and the draft is sent.</li>
          <li>Set Reasoning to show, and the reasoning block opens above the answer.</li>
          <li>Approve or deny the branch deletion. Its status changes with your choice.</li>
          <li>Click an arrow in a version switcher, or Regenerate in Claude's menu (right-click a message).</li>
          <li>Click a citation number to see its link. Click a suggestion. One fills the box, and <em>Thanks, that helps</em> sends.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="threads">
        <div class="card" data-card="threads">
        <p>Replies open in a panel beside the list, or under their message. A long list draws only what's on screen, and scrolling to its top asks for older messages.</p>
        <div class="row">
          <label>Threads
            <select data-attr="threads">
              <option value="none">none</option>
              <option value="inline">inline</option>
              <option value="panel">panel</option>
            </select>
          </label>
          <label>Presence
            <select data-attr="presence">
              <option value="none">none</option>
              <option value="sampled">sampled</option>
              <option value="full">full</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="threads-reply">Grace replies in the thread</button>
          <button type="button" data-simulate="threads-batch">Add 300 messages</button>
          <button type="button" data-reset="threads">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="threads"></div>
        <ul class="try">
          <li>Click Open thread under the first message. Reply in the panel, and your reply shows there. Escape closes it.</li>
          <li>Set Threads to inline. The replies show under their message, and Hide and Show toggle them.</li>
          <li>Click Add 300 messages, then scroll up. The app loads 20 older messages, and the message you're reading stays where it is.</li>
          <li>Scroll up, then click the pill at the bottom to go back to the newest message.</li>
          <li>Set Presence to full, and the header names who's online.</li>
        </ul>
      </div>
      </orb-tab-panel>

      <orb-tab-panel name="transports">
        <div class="card" data-card="transports">
        <p>The channel sends through a transport. Here it's a fake server with a short delay. A message shows as sending until the server has it, and the server's copy replaces it. The transport can also page older messages in. With drafts on, the text in the box is kept in the page's storage, so it survives a reload.</p>
        <div class="row">
          <label>Point of view
            <select data-attr="pov">
              <option value="ada">Ada</option>
              <option value="grace">Grace</option>
            </select>
          </label>
          <label>Drafts
            <select data-attr="drafts">
              <option value="">none</option>
              <option value="persist">persist</option>
            </select>
          </label>
        </div>
        <div class="row">
          <button type="button" data-simulate="transports-grace">Grace posts a message</button>
          <button type="button" data-simulate="transports-fail">The server fails the next send</button>
          <button type="button" data-simulate="transports-older">Load older messages</button>
          <button type="button" data-reset="transports">Reset</button>
          <span class="readout" data-readout></span>
        </div>
        <div class="slot" data-slot="transports"></div>
        <ul class="try">
          <li>Send a message. It shows as sending, then it's replaced by the server's copy.</li>
          <li>Click "The server fails the next send", then send. The message says why it failed. Press Retry to send it again.</li>
          <li>Click "Grace posts a message" to see a message arrive from the server.</li>
          <li>Scroll to the top, or click "Load older messages". Older messages come in above, three at a time.</li>
          <li>Type a draft, then reload the page. It's still in the box. Set Drafts to none, and drafts aren't kept. Reset clears the saved draft.</li>
          <li>Without JavaScript, <code>&lt;orb-channel-transport&gt;</code> sends and receives over a form, server-sent events, a WebSocket or polling. Those need a real server, so this page doesn't use one.</li>
        </ul>
      </div>
      </orb-tab-panel>
    </orb-tabs>

    <section class="log">
      <div class="row">
        <h2>Event log</h2>
        <button type="button" data-clear-log>Clear</button>
      </div>
      <ol id="log" aria-live="polite"></ol>
    </section>
  </main>

  <!-- The channels. Each one is cloned into its card, so Reset rebuilds it. -->

  <template id="tpl-direct">
    <orb-channel id="chan-direct" label="Grace" pov="ada" echo>
      <orb-channel-participant id="ada" name="Ada"></orb-channel-participant>
      <orb-channel-participant id="grace" name="Grace" accent="#7c3aed"></orb-channel-participant>
      <orb-channel-message id="d1" from="grace" ts="2025-06-01T09:14:00Z">Did the compiler change land?</orb-channel-message>
      <orb-channel-message id="d2" from="ada" ts="2025-06-01T09:15:00Z"><script type="text/markdown">Yep, merged this morning. The notes are in **the wiki**.</script></orb-channel-message>
      <orb-channel-message id="d3" from="grace" ts="2025-06-01T09:16:00Z">Nice work!<orb-channel-reaction emoji="🎉" by="ada"></orb-channel-reaction></orb-channel-message>
      <orb-channel-message id="d4" from="grace" ts="2025-06-02T08:00:00Z">The spec is at https://example.com/spec. @Ada can you check the numbers?</orb-channel-message>
      <orb-channel-message id="d5" from="grace" ts="2025-06-02T08:02:00Z">The screenshot from this morning:<orb-channel-attachment href="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" name="screenshot.gif" type="image/gif"></orb-channel-attachment></orb-channel-message>
      <orb-channel-message id="d6" from="ada" ts="2025-06-02T08:05:00Z"><script type="text/html"><p>Also, <strong>this</strong> one is <em>HTML</em>, with a <a href="javascript:alert(1)">bad link</a> that gets removed.</p></script></orb-channel-message>
      <orb-channel-composer name="direct" placeholder="Message Grace"></orb-channel-composer>
    </orb-channel>
  </template>

  <template id="tpl-group">
    <orb-channel id="chan-group" label="Design team" kind="group" pov="ada" echo>
      <orb-channel-participant id="ada" name="Ada"></orb-channel-participant>
      <orb-channel-participant id="grace" name="Grace" accent="#7c3aed"></orb-channel-participant>
      <orb-channel-participant id="lin" name="Lin"></orb-channel-participant>
      <orb-channel-message id="g1" from="grace" ts="2025-06-01T09:00:00Z">Morning, everyone.</orb-channel-message>
      <orb-channel-message id="g2" from="grace" ts="2025-06-01T09:01:00Z">Two more things from yesterday.</orb-channel-message>
      <orb-channel-message id="g3" from="ada" ts="2025-06-01T09:02:00Z">Go ahead.</orb-channel-message>
      <orb-channel-message id="g4" from="lin" ts="2025-06-01T09:20:00Z">The new icons are in the library.</orb-channel-message>
