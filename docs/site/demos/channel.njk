  <template id="tpl-transports">
    <orb-channel id="chan-transports" label="Launch" pov="ada" key="demo-drafts" drafts="persist">
      <orb-channel-participant id="ada" name="Ada"></orb-channel-participant>
      <orb-channel-participant id="grace" name="Grace"></orb-channel-participant>
      <orb-channel-message id="tr1" from="grace">Morning. The release branch is green.</orb-channel-message>
      <orb-channel-message id="tr2" from="ada">Nice. Are the migration notes done?</orb-channel-message>
      <orb-channel-message id="tr3" from="grace">Almost. Two sections left.</orb-channel-message>
      <orb-channel-message id="tr4" from="ada">I can take one of them.</orb-channel-message>
      <orb-channel-message id="tr5" from="grace">Thanks. The API section is yours, then.</orb-channel-message>
      <orb-channel-message id="tr6" from="ada">Done by lunch.</orb-channel-message>
      <orb-channel-message id="tr7" from="grace">Great. I'll start the changelog.</orb-channel-message>
      <orb-channel-message id="tr8" from="ada">Should we mention the new transports?</orb-channel-message>
      <orb-channel-message id="tr9" from="grace">Yes, in one line, with a link.</orb-channel-message>
      <orb-channel-message id="tr10" from="ada">I'll draft it now.</orb-channel-message>
      <orb-channel-message id="tr11" from="grace">Perfect.</orb-channel-message>
      <orb-channel-message id="tr12" from="ada">Sending it to review.</orb-channel-message>
      <orb-channel-composer name="transports" placeholder="Type a message"></orb-channel-composer>
    </orb-channel>
  </template>

  <script type="module">
    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

    /** The channel in a card, by the card's name */
    const channelOf = (name) => $(`[data-card="${name}"] orb-channel`);
    /** The card a channel is in */
    const nameOf = (channel) => channel.closest("[data-card]")?.dataset.card ?? channel.id;

    // Builds a card's channel from its template, so Reset can rebuild it
    function mount(name) {
      const card = $(`[data-card="${name}"]`);
      $(`[data-slot="${name}"]`, card).replaceChildren($(`#tpl-${name}`).content.cloneNode(true));
      syncControls(card);
      if (name === "transports") connectServer($("orb-channel", card));
    }

    // The controls show the channel's attributes, and change them when used
    function syncControls(card) {
      for (const control of $$("[data-attr]", card)) {
        const target = targetOf(control, card);
        if (!target) continue;
        const attr = control.dataset.attr;
        const value = target.getAttribute(attr);
        if ("tri" in control.dataset) control.value = value === null ? "default" : value === "false" ? "off" : "on";
        else control.value = value ?? "";
      }
    }

    function targetOf(control, card) {
      const channel = $("orb-channel", card);
      return control.dataset.on ? channel?.querySelector(control.dataset.on) : channel;
    }

    document.addEventListener("change", (event) => {
      const control = event.target.closest?.("[data-attr]");
      if (!control) return;
      const card = control.closest("[data-card]");
      const target = targetOf(control, card);
      if (!target) return;
      const attr = control.dataset.attr;
      if ("tri" in control.dataset) {
        if (control.value === "default") target.removeAttribute(attr);
        else target.setAttribute(attr, control.value === "on" ? "" : "false");
      } else if (control.value) target.setAttribute(attr, control.value);
      else target.removeAttribute(attr);
      record(`${card.dataset.card}: ${attr} = ${control.value}`);
    });

    // A message added the way a server would add one, before the composer
    function say(channel, from, text, attrs = {}) {
      const el = document.createElement("orb-channel-message");
      el.id = `sim-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`;
      el.setAttribute("from", from);
      el.setAttribute("ts", new Date().toISOString());
      for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, value);
      el.textContent = text;
      const composer = channel.querySelector(":scope > orb-channel-composer");
      if (composer) composer.before(el);
      else channel.append(el);
      return el;
    }

    /** The last message in a channel from someone */
    const lastFrom = (channel, from) => [...channel.querySelectorAll(`:scope > orb-channel-message[from="${from}"]`)].at(-1);

    const simulations = {
      "direct-grace": (channel) => say(channel, "grace", "Are you around for a quick call?"),
      "direct-reaction": (channel) => {
        const message = lastFrom(channel, "ada");
        // Grace reacts to Ada's last message
        const reaction = document.createElement("orb-channel-reaction");
        reaction.setAttribute("emoji", "👍");
        reaction.setAttribute("by", "grace");
        message?.append(reaction);
      },
      "direct-link": (channel) => say(channel, "grace", "Here's the link again: https://example.com/spec"),
      "group-lin": (channel) => say(channel, "lin", "Sounds good to me."),
      "group-unread": (channel) => {
        const last = channel.querySelector(":scope > orb-channel-message:last-of-type") ?? channel.querySelector(":scope > orb-channel-message");
        const divider = document.createElement("orb-channel-divider");
        divider.setAttribute("type", "unread");
        last?.before(divider);
      },
      "group-tomorrow": (channel) =>
        say(channel, "grace", "Good morning again.", { ts: new Date(Date.now() + 86400000).toISOString() }),
      "open-batch": (channel) => {
        for (let i = 1; i <= 20; i++) say(channel, i % 2 ? "u2" : "u3", `Message ${i} of the batch.`);
      },
      "open-jump": (channel) => channel.scrollToMessage("open-first", { behavior: "smooth" }),
      "open-focus": (channel) => channel.focusComposer(),
      "open-send": (channel) => channel.send("Sent from code with send()"),
      "moderation-troll": (channel) => say(channel, "troll", "Free money at example.com!"),
      "moderation-pending": (channel) => say(channel, "grace", "Waiting for a moderator to approve this.", { moderation: "pending" }),
      "rich-send": (channel) => channel.send("Sent from code with send()"),
      "bare-ada": (channel) => say(channel, "ada", "The first message."),
      "ai-approval": (channel) => {
        const message = document.createElement("orb-channel-message");
        message.setAttribute("from", "claude");
        message.setAttribute("ts", new Date().toISOString());
        message.innerHTML = `<orb-channel-reasoning state="done" duration="1.8s">Old branches are safe to remove once they're merged.</orb-channel-reasoning><orb-channel-tool-call name="delete_branch" call-id="sim-${Date.now()}" status="awaiting-approval" requires-approval><script type="application/json" data-part="args">{"branch": "old-api"}<\/script></orb-channel-tool-call>I can delete the old-api branch once you approve.`;
        channel.querySelector(":scope > orb-channel-composer").before(message);
      },
      "ai-write": (channel) => answer(channel, "claude"),
      "threads-reply": (channel) => say(channel, "grace", "Thanks, all!", { thread: "t1" }),
      "threads-batch": (channel) => {
        for (let i = 1; i <= 300; i++) say(channel, i % 2 ? "lin" : "grace", `Message ${i} of the batch.`);
      },
      "transports-grace": () => server.handlers.receive(`<orb-channel-message id="posted-${Date.now()}" from="grace">Posted by the server, not typed here.</orb-channel-message>`),
      "transports-fail": () => (server.failNext = true),
      "transports-older": (channel) => channel.scrollToMessage(channel.querySelector(":scope > orb-channel-message").id, { behavior: "auto" }),
    };

    // The transports card's fake server. It answers each send after a short delay, and can fail the next one.
    const DRAFT_KEY = "orb-channel-draft:demo-drafts";
    const server = { handlers: undefined, failNext: false, older: [], copies: 0 };
    const escapeHtml = (text) => text.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

    function connectServer(channel) {
      server.older = Array.from({ length: 9 }, (_, i) => `<orb-channel-message id="older-${i + 1}" from="${i % 2 ? "ada" : "grace"}">Older message ${i + 1}</orb-channel-message>`);
      server.failNext = false;
      customElements.whenDefined("orb-channel").then(() => {
        channel.transport = {
          async send(message) {
            await sleep(700);
            if (server.failNext) {
              server.failNext = false;
              throw new Error("Offline. Check the connection.");
            }
            server.handlers.receive(`<orb-channel-message id="sent-${++server.copies}" from="${message.from}" client-id="${message.clientId}">${escapeHtml(message.text)}</orb-channel-message>`);
          },
          subscribe(handlers) {
            server.handlers = handlers;
            return () => (server.handlers = undefined);
          },
          async history() {
            await sleep(500);
            return server.older.splice(-3).join("");
          },
        };
      });
    }

    // Rebuilds a card. Reset also clears the transports card's saved draft.
    function reset(name) {
      if (name === "transports") localStorage.removeItem(DRAFT_KEY);
      mount(name);
    }

    // The log: every event the channels emit
    const log = $("#log");
    function record(text, kind = "") {
      const item = document.createElement("li");
      item.textContent = `${new Date().toLocaleTimeString()}  ${text}`;
      if (kind) item.dataset.kind = kind;
      log.prepend(item);
      while (log.children.length > 300) log.lastElementChild.remove();
    }

    const preview = (node) => (node?.textContent ?? "").trim().slice(0, 40) || node?.id || "(message)";

    /** The app's answers. Each one changes the DOM, or cancels the event. */
    document.addEventListener("orbSend", (event) => {
      const detail = event.detail;
      const name = nameOf(event.target);
      if ($("#cancel-short").checked && !detail.files.length && detail.text.trim().length < 5) {
        event.preventDefault();
        record(`${name}  orbSend canceled, too short: "${detail.text}"`, "cancel");
        return;
      }
      record(`${name}  orbSend ${JSON.stringify({
        text: detail.text,
        format: detail.format,
        mentions: detail.mentions,
        command: detail.command,
        files: detail.files.map((file) => file.name),
      })}`);
    });

    document.addEventListener("orbRetry", (event) => {
      record(`${nameOf(event.target)}  orbRetry on "${preview(event.detail.message)}"`);
    });

    document.addEventListener("orbReact", (event) => {
      const { message, emoji, on } = event.detail;
      const channel = event.target;
      const mine = message.querySelector(`orb-channel-reaction[emoji="${emoji}"][by="${channel.pov}"]`);
      if (on && !mine) {
        const reaction = document.createElement("orb-channel-reaction");
        reaction.setAttribute("emoji", emoji);
        reaction.setAttribute("by", channel.pov);
        message.append(reaction);
      }
      if (!on) mine?.remove();
      record(`${nameOf(channel)}  orbReact ${emoji} ${on ? "on" : "off"} on "${preview(message)}"`);
    });

    document.addEventListener("orbEdit", (event) => {
      record(`${nameOf(event.target)}  orbEdit on "${preview(event.detail.message)}"`);
    });

    document.addEventListener("orbEditCommit", (event) => {
      const { message, text } = event.detail;
      if ($("#keep-edit").checked) {
        event.preventDefault();
        record(`${nameOf(event.target)}  orbEditCommit canceled, the editor stays open`, "cancel");
        return;
      }
      // Replaces the text but keeps the reactions and attachments
      for (const node of [...message.childNodes]) if (node.nodeType === Node.TEXT_NODE) node.remove();
      message.prepend(text);
      message.setAttribute("edited", "");
      record(`${nameOf(event.target)}  orbEditCommit "${text}"`);
    });

    document.addEventListener("orbDelete", (event) => {
      const message = event.detail.message;
      if ($("#keep-deleted").checked) {
        event.preventDefault();
        record(`${nameOf(event.target)}  orbDelete canceled, the message stays`, "cancel");
        return;
      }
      message.remove();
      record(`${nameOf(event.target)}  orbDelete "${preview(message)}"`);
    });

    document.addEventListener("orbReply", (event) => {
      record(`${nameOf(event.target)}  orbReply to "${preview(event.detail.message)}"`);
    });

    document.addEventListener("orbReport", (event) => {
      record(`${nameOf(event.target)}  orbReport "${preview(event.detail.message)}"`, "cancel");
    });

    document.addEventListener("orbModerate", (event) => {
      const { action, message, participant } = event.detail;
      if (action === "hide") {
        message.setAttribute("moderation", "hidden");
        message.setAttribute("moderation-reason", "Hidden by a moderator");
      }
      if (action === "remove") message.setAttribute("moderation", "removed");
      if (action === "pin") message.setAttribute("pinned", "");
      if (action === "unpin") message.removeAttribute("pinned");
      if (action === "mute" && participant) participant.setAttribute("muted", "");
      record(`${nameOf(event.target)}  orbModerate ${action} on "${preview(message)}"`);
    });

    document.addEventListener("orbAction", (event) => {
      record(`${nameOf(event.target)}  orbAction ${event.detail.name}`);
    });

    let reads = 0;
    document.addEventListener("orbRead", () => ($("#read-count").textContent = String(++reads)));

    // The AI card's app. Claude answers the messages that name it, streaming its answer with the message writer.
    const { createMessageWriter } = await import("/build/components/index.js");
    const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    let stopRequested = false;

    async function answer(channel, from) {
      stopRequested = false;
      const writer = createMessageWriter(channel, { from });
      writer.reasoning("The question is about the release. I'll check the notes first.");
      await sleep(700);
      writer.text("Here's the short version. ");
      for (const sentence of ["The compiler is faster. ", "Imports are stricter now. ", "The migration guide has the details."]) {
        if (stopRequested) break;
        await sleep(600);
        writer.text(sentence);
      }
      writer.finish();
      record(`${nameOf(channel)}  Claude ${stopRequested ? "stopped" : "finished"} its answer`);
    }

    document.addEventListener("orbSend", (event) => {
      const channel = event.target;
      if (nameOf(channel) !== "ai" || !event.detail.respondents.length) return;
      // The echo of the question is added after this event, so the answer starts after it
      setTimeout(() => answer(channel, event.detail.respondents[0]), 0);
    });

    document.addEventListener("orbStop", (event) => {
      if (nameOf(event.target) !== "ai") return;
      stopRequested = true;
      record("ai  orbStop, the answer stops", "cancel");
    });

    document.addEventListener("orbToolDecision", (event) => {
      const { toolCall, callId, approved } = event.detail;
      toolCall.setAttribute("status", approved ? "done" : "denied");
      record(`${nameOf(event.target)}  orbToolDecision ${callId} ${approved ? "approved" : "denied"}`);
    });

    const VERSIONS = ["Version one: Porto is best in spring.", "Version two: Porto is lovely in late September."];
    document.addEventListener("orbVariantChange", (event) => {
      const { message, current } = event.detail;
      event.target.replaceFrom(
        message,
        `<orb-channel-message from="claude">${VERSIONS[current - 1]}<orb-channel-variants current="${current}" count="${VERSIONS.length}"></orb-channel-variants></orb-channel-message>`,
      );
      record(`${nameOf(event.target)}  orbVariantChange to version ${current}`);
    });

    document.addEventListener("orbRegenerate", (event) => {
      event.target.replaceFrom(event.detail.message, `<orb-channel-message from="claude">A fresh take: the release is mostly about the compiler.</orb-channel-message>`);
      record(`${nameOf(event.target)}  orbRegenerate, a new answer replaces it`);
    });

    // Threads, long lists and presence. The app loads older messages for the threads card.
    for (const name of ["orbThreadOpen", "orbThreadClose", "orbTyping"]) {
      document.addEventListener(name, (event) => {
        const detail = name === "orbTyping" ? ` ${event.detail.typing ? "on" : "off"}` : "";
        record(`${nameOf(event.target)}  ${name}${detail} ${event.detail.parent ? `on "${preview(event.detail.parent)}"` : ""}`);
      });
    }


    document.addEventListener("orbLoadMore", async (event) => {
      const channel = event.target;
      if (event.detail.parent) {
        record(`${nameOf(channel)}  orbLoadMore for the replies of "${preview(event.detail.parent)}"`);
        return;
      }
      if (nameOf(channel) === "transports") {
        record(`${nameOf(channel)}  orbLoadMore before "${event.detail.cursor}", the transport answers`);
        return;
      }
      record(`${nameOf(channel)}  orbLoadMore before "${event.detail.cursor}"`);
      channel.setAttribute("loading-more", "");
      await sleep(600);
      const first = channel.querySelector("orb-channel-message");
      for (let i = 1; i <= 20; i++) {
        const older = document.createElement("orb-channel-message");
        older.id = `older-${event.detail.cursor}-${i}`;
        older.setAttribute("from", "grace");
        older.textContent = `Older message ${i}`;
        channel.insertBefore(older, first);
      }
      channel.removeAttribute("loading-more");
    });

    // The readouts, updated as the channels change
    setInterval(() => {
      for (const card of $$("[data-card]")) {
        const channel = $("orb-channel", card);
        const readout = $("[data-readout]", card);
        if (!channel || !readout) continue;
        const messages = channel.querySelectorAll(":scope > orb-channel-message").length;
        readout.textContent = `${messages} message${messages === 1 ? "" : "s"} · unread ${channel.unread ?? 0}`;
      }
    }, 300);

    // Buttons
    document.addEventListener("click", (event) => {
      const button = event.target.closest("button");
      if (!button) return;
      if (button.dataset.simulate) {
        const channel = channelOf(button.dataset.simulate.split("-")[0]);
        simulations[button.dataset.simulate]?.(channel);
        record(`simulated: ${button.textContent.trim()}`);
      } else if (button.dataset.reset) {
        reset(button.dataset.reset);
        record(`reset ${button.dataset.reset}`);
      } else if ("resetAll" in button.dataset) {
        for (const name of ["direct", "group", "open", "moderation", "rich", "limits", "plain", "bare", "ai", "threads", "transports"]) reset(name);
        record("reset all");
      } else if (button.dataset.mute) {
        const participant = channelOf("limits").querySelector(`orb-channel-participant#${button.dataset.mute}`);
        participant.toggleAttribute("muted");
        record(`${button.dataset.mute} is ${participant.hasAttribute("muted") ? "muted" : "unmuted"}`);
      } else if ("formdata" in button.dataset) {
        const form = $("#plain-form");
        record(`form data: ${JSON.stringify(Object.fromEntries(new FormData(form)))}`);
      } else if ("clearLog" in button.dataset) {
        log.replaceChildren();
      }
    });

    for (const name of ["direct", "group", "open", "moderation", "rich", "limits", "plain", "bare", "ai", "threads", "transports"]) mount(name);
  </script>
</body>

</html>
