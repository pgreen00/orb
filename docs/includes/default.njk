{% set navSections = [
  { key: "installation", label: "Installation", href: "/installation/" },
  { key: "tutorials", label: "Tutorials", href: "/tutorials/" },
  { key: "components", label: "Components", href: "/components/" },
  { key: "css-utilities", label: "CSS Utilities", href: "/css-utilities/" }
] %}
<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/orb.png" />
  <meta
    name="viewport"
    content="width=device-width, user-scalable=no"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
  <title>{% if title %}{{ title }} | Orb Design System{% else %}Orb Design System{% endif %}</title>
  <style>@view-transition {navigation: auto;}</style>
  <script type="importmap">
    {
      "imports": {
        "orb-style": "/build/components/index.js",
        "orb-style/": "/build/components/"
      }
    }
  </script>
  <script type="module">
    const t = localStorage.getItem('orb__theme') || 'system'
    const el = document.documentElement
    el.classList.toggle('orb-theme-light', t === 'light')
    el.classList.toggle('orb-theme-dark', t === 'dark')
  </script>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/build/styles/index.css" />
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"></script>
  <script type="module" src="/build/loader.js"></script>
  <script type="module" src="/mermaid.js"></script>
</head>

<body>
  <header>
    <orb-toolbar>
      <a data-orb="quiet" class="banner-title orb-font-semi-bold" href="/">
        <img src="/orb.png" alt="logo" height="42" width="42" />
        <span class="orb-margin-left-xs">Orb Design System</span>
      </a>
      <nav class="section-nav" aria-label="Sections">
        <ul data-orb="nav">
          {% for item in navSections %}
            <li><a href="{{ item.href }}"{% if section == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <orb-button id="search-button" class="icon-only" fill="clear" size="lg" slot="end" aria-label="Search" aria-keyshortcuts="Control+K Meta+K">
        <iconify-icon height="2rem" width="2rem" icon="mdi:search" aria-hidden="true"></iconify-icon>
      </orb-button>
      <a href="https://github.com/pgreen00/orb" target="_blank" slot="end">
        <iconify-icon height="2.5rem" width="2.5rem" icon="akar-icons:github-fill"></iconify-icon>
      </a>
      <orb-button id="theme-button" class="icon-only" slot="end" size="lg" aria-label="Theme">
        <iconify-icon height="1.5rem" width="1.5rem" icon="mdi:moon-and-stars"></iconify-icon>
      </orb-button>
      <orb-menu id="theme-menu" for="theme-button" placement="bottom-end" slot="end">
        <orb-mi type="radio" value="system">
          <iconify-icon slot="icon" icon="mdi:moon-and-stars"></iconify-icon>
          System
        </orb-mi>
        <orb-mi type="radio" value="light">
          <iconify-icon slot="icon" icon="material-symbols:light-mode"></iconify-icon>
          Light
        </orb-mi>
        <orb-mi type="radio" value="dark">
          <iconify-icon slot="icon" icon="material-symbols:dark-mode"></iconify-icon>
          Dark
        </orb-mi>
      </orb-menu>
    </orb-toolbar>
  </header>
  {% if section in ["tutorials", "components", "css-utilities"] %}
  <nav data-landmark="sidebar" aria-label="Section navigation">
    {% if section == "tutorials" %}
      {% set sideLinks = [
        { label: "Forms", href: "/tutorials/forms/" },
        { label: "Themes", href: "/tutorials/themes/" },
        { label: "Data Tables", href: "/tutorials/data-tables/" },
        { label: "Design Patterns", href: "/tutorials/design-patterns/" }
      ] %}
    {% elif section == "css-utilities" %}
      {% set sideLinks = [
        { label: "Design Tokens", href: "/css-utilities/design-tokens/" },
        { label: "Utility Classes", href: "/css-utilities/classes/" },
        { label: "Landmarks", href: "/css-utilities/landmarks/" },
        { label: "Links", href: "/css-utilities/links/" },
        { label: "Tables", href: "/css-utilities/tables/" },
        { label: "Lists", href: "/css-utilities/lists/" }
      ] %}
    {% else %}
      {% set sideLinks = [] %}
    {% endif %}
    <ul data-orb="vertical-nav">
      {% if section == "components" %}
        {% for component in collections.componentsNav %}
          {% set href = "/components/" + component.name + "/" %}
          <li><a href="{{ href }}"{% if page.url == href %} aria-current="page"{% endif %}>{{ component.data.sidebar_label or component.name }}</a></li>
        {% endfor %}
      {% else %}
        {% for item in sideLinks %}
          <li><a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      {% endif %}
    </ul>
    <script type="module">
      // Center the current page in the sidebar without scrolling the window
      const sidebar = document.querySelector('[data-landmark="sidebar"]')
      const current = sidebar.querySelector('[aria-current]')
      requestAnimationFrame(() => {
        //if (!current) return
        //const offset = current.getBoundingClientRect().top - sidebar.getBoundingClientRect().top
        //sidebar.scrollTop += offset - (sidebar.clientHeight - current.offsetHeight) / 2
      })
    </script>
  </nav>
  {% endif %}
  <main>
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>
  <orb-overlay id="search-overlay" trigger="search-button">
    <orb-view label="Search" heading-level="2" closable>
      <orb-textbox id="search-textbox" slot="details" debounce="150">
        <iconify-icon slot="start" icon="mdi:magnify" aria-hidden="true"></iconify-icon>
        <input type="search" aria-label="Search the docs" placeholder="Search components, guides, and APIs" autocomplete="off" enterkeyhint="search" spellcheck="false">
      </orb-textbox>
      <p id="search-status" role="status" class="search-status"></p>
      <ul id="search-results" class="search-results" aria-label="Search results"></ul>
    </orb-view>
  </orb-overlay>
  <script type="module" src="/search.js"></script>
  <orb-floating-button id="back-to-top" scroll-threshold="400">
    <orb-button class="icon-only" color="primary" aria-label="Back to top">
      <iconify-icon height="1.5rem" width="1.5rem" icon="mdi:arrow-up" aria-hidden="true"></iconify-icon>
    </orb-button>
  </orb-floating-button>
  <script type="module">
    const backToTop = document.querySelector('#back-to-top orb-button')
    backToTop.addEventListener('click', () => {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })
      // The button hides at the top, so move focus to the page heading
      const heading = document.querySelector('main h1')
      if (heading) {
        heading.tabIndex = -1
        heading.focus({ preventScroll: true })
      }
    })
  </script>
</body>

<script type="module">
  async function setTheme(theme) {
    const htmlEl = document.querySelector('html')
    localStorage.setItem('orb__theme', theme ?? 'system')
    htmlEl.classList.toggle('orb-theme-light', theme === 'light')
    htmlEl.classList.toggle('orb-theme-dark', theme === 'dark')
    const menuItems = Array.from(document.querySelectorAll('#theme-menu > orb-mi'))
    await customElements.whenDefined('orb-mi')
    for (const item of menuItems) {
      item.checked = theme == item.value
    }
  }
  setTheme(localStorage.getItem('orb__theme'))
  const themeMenu = document.querySelector('#theme-menu')
  themeMenu.addEventListener('orbSelect', ev => {
    setTheme(ev.detail.value)
  })
</script>

</html>
