
{% set themes = [
  { value: "system", label: "System", icon: "mdi:moon-and-stars" },
  { value: "light", label: "Light", icon: "material-symbols:light-mode" },
  { value: "dark", label: "Dark", icon: "material-symbols:dark-mode" }
] %}
<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/orb.png" />
  <meta
    name="viewport"
    content="width=device-width, user-scalable=no, initial-scale=1"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
  <title>{% if title %}{{ title }} | Orb Design System{% else %}Orb Design System{% endif %}</title>
  <script type="importmap">
    {
      "imports": {
        "orb-style": "/build/components/index.js",
        "orb-style/": "/build/components/"
      }
    }
  </script>
  <script type="module">
    const t = localStorage.getItem('orb__theme') || 'system'
    const el = document.documentElement
    el.classList.toggle('orb-theme-light', t === 'light')
    el.classList.toggle('orb-theme-dark', t === 'dark')
  </script>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/build/orb.css" />
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"></script>
  <script type="module" src="/build/loader.js"></script>
  <script type="module" src="/mermaid.js"></script>
</head>

<body>
  <header>
    <orb-toolbar>
      <orb-button id="menu-button" class="icon-only menu-button" fill="clear" size="lg" aria-label="Sections" aria-haspopup="dialog">
        <iconify-icon height="2rem" width="2rem" icon="mdi:menu" aria-hidden="true"></iconify-icon>
      </orb-button>
      <a data-orb="quiet" class="banner-title" href="/">
        <img class="banner-logo" src="/orb.png" alt="" height="42" width="42" />
        <span class="orb-margin-left-xs">Orb<span class="banner-rest"> Design System</span></span>
      </a>
      <nav class="section-nav" aria-label="Sections">
        <ul data-orb="nav">
          {% for item in collections.sectionLandings %}
            <li><a href="{{ item.url }}"{% if section == item.data.section %} aria-current="page"{% endif %}>{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <orb-button id="search-button" class="icon-only" fill="clear" slot="end" aria-label="Search" aria-keyshortcuts="Control+K Meta+K">
        <iconify-icon height="2rem" icon="mdi:search" aria-hidden="true"></iconify-icon>
      </orb-button>
      <orb-layout-swap breakpoint="900" slot="end">
        <div slot="desktop" class="header-actions">
          <a href="https://github.com/pgreen00/orb" target="_blank" aria-label="GitHub">
            <iconify-icon height="2rem" icon="akar-icons:github-fill" aria-hidden="true"></iconify-icon>
          </a>
          <orb-button id="theme-button" class="icon-only" aria-label="Theme">
            <iconify-icon height="1.5em" width="1.5em" icon="mdi:moon-and-stars" aria-hidden="true"></iconify-icon>
          </orb-button>
          <orb-menu data-theme-menu for="theme-button" placement="bottom-end">
            {% for theme in themes %}
            <orb-mi type="radio" value="{{ theme.value }}">
              <iconify-icon slot="icon" icon="{{ theme.icon }}"></iconify-icon>
              {{ theme.label }}
            </orb-mi>
            {% endfor %}
          </orb-menu>
        </div>
      </orb-layout-swap>
    </orb-toolbar>
  </header>
  {% set sidebarItems = collections.sidebarPages | inSection(section) %}
  {% if sidebarItems.length %}
  <nav data-landmark="sidebar" aria-label="Section navigation">
    <ul data-orb="vertical-nav">
      {% for item in sidebarItems %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.data.sidebar_label or item.data.title }}</a></li>
      {% endfor %}
    </ul>
  </nav>
  {% endif %}
  <main>
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>
  <orb-overlay id="nav-overlay" trigger="menu-button" side="left">
    <orb-view label="Sections" heading-level="2" closable>
      <nav aria-label="Sections">
        <ul data-orb="vertical-nav">
          {% for item in collections.sectionLandings %}
            <li><a href="{{ item.url }}"{% if section == item.data.section %} aria-current="page"{% endif %}>{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <div class="overlay-actions">
        <a href="https://github.com/pgreen00/orb" target="_blank" aria-label="GitHub">
          <iconify-icon height="2rem" icon="akar-icons:github-fill" aria-hidden="true"></iconify-icon>
        </a>
        <orb-button id="theme-button-mobile" class="icon-only" size="lg" aria-label="Theme">
          <iconify-icon height="1.5em" icon="mdi:moon-and-stars" aria-hidden="true"></iconify-icon>
        </orb-button>
        <orb-menu data-theme-menu for="theme-button-mobile" placement="bottom-start">
          {% for theme in themes %}
          <orb-mi type="radio" value="{{ theme.value }}">
            <iconify-icon slot="icon" icon="{{ theme.icon }}"></iconify-icon>
            {{ theme.label }}
          </orb-mi>
          {% endfor %}
        </orb-menu>
      </div>
    </orb-view>
  </orb-overlay>
  <orb-overlay id="search-overlay" trigger="search-button">
    <orb-view label="Search" heading-level="2" closable>
      <orb-textbox id="search-textbox" slot="details" debounce="150">
        <iconify-icon slot="start" icon="mdi:magnify" aria-hidden="true"></iconify-icon>
        <input type="search" aria-label="Search the docs" placeholder="Search components, guides, and APIs" autocomplete="off" enterkeyhint="search" spellcheck="false">
      </orb-textbox>
      <p id="search-status" role="status" class="search-status"></p>
      <ul id="search-results" class="search-results" aria-label="Search results"></ul>
    </orb-view>
  </orb-overlay>
  <script type="module" src="/search.js"></script>
  <orb-floating-button id="back-to-top" scroll-threshold="400">
    <orb-button class="icon-only" color="primary" aria-label="Back to top">
      <iconify-icon height="1.5rem" width="1.5rem" icon="mdi:arrow-up" aria-hidden="true"></iconify-icon>
    </orb-button>
  </orb-floating-button>
  <script type="module">
    const backToTop = document.querySelector('#back-to-top orb-button')
    backToTop.addEventListener('click', () => {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })
      // The button hides at the top, so move focus to the page heading
      const heading = document.querySelector('main h1')
      if (heading) {
        heading.tabIndex = -1
        heading.focus({ preventScroll: true })
      }
    })
  </script>
  <script type="module">
    async function setTheme(theme) {
      const htmlEl = document.querySelector('html')
      localStorage.setItem('orb__theme', theme ?? 'system')
      htmlEl.classList.toggle('orb-theme-light', theme === 'light')
      htmlEl.classList.toggle('orb-theme-dark', theme === 'dark')
      const menuItems = Array.from(document.querySelectorAll('[data-theme-menu] > orb-mi'))
      await customElements.whenDefined('orb-mi')
      for (const item of menuItems) {
        item.checked = theme == item.value
      }
    }
    setTheme(localStorage.getItem('orb__theme'))
    // The header and the menu overlay each have a theme menu
    for (const themeMenu of document.querySelectorAll('[data-theme-menu]')) {
      themeMenu.addEventListener('orbSelect', ev => {
        setTheme(ev.detail.value)
      })
    }
  </script>
</body>

</html>
