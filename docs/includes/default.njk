<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/hex-tag.svg" />
  <meta
    name="viewport"
    content="width=device-width, user-scalable=no"
  />
  <title>Orb Design System</title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/prism.css" />
  <link rel="stylesheet" href="/build/styles/core.css" />
  <link rel="stylesheet" href="/build/styles/landmarks.css" />
  <link rel="stylesheet" href="/build/styles/classes.css" />
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"></script>
  <script type="importmap">
    {
      "imports": {
        "orb-style": "/build/components/index.js",
        "orb-style/": "/build/components/"
      }
    }
  </script>
  <script type="module" src="/build/loader.js"></script>
  <script type="module" src="/mermaid.js"></script>
</head>

<body>
  <header>
    <orb-toolbar>
      <orb-link class="banner-title" underline="false" bold neutral href="/">
        <img src="/hex-tag.svg" alt="logo" height="42" width="42" />
        <span class="orb-margin-left-xs">Orb Design System</span>
      </orb-link>
      <orb-button class="icon-only" fill="clear" size="lg" slot="end">
        <iconify-icon height="2rem" width="2rem" icon="mdi:search"></iconify-icon>
      </orb-button>
      <orb-link href="https://github.com/pgreen00/orb" target="_blank" neutral underline="false" slot="end">
        <iconify-icon height="2.5rem" width="2.5rem" icon="akar-icons:github-fill"></iconify-icon>
      </orb-link>
      <orb-popover slot="end" placement="bottom-end" trigger-action="hover">
        <orb-button class="icon-only" slot="trigger" size="lg">
          <iconify-icon height="1.5rem" width="1.5rem" icon="mdi:moon-and-stars"></iconify-icon>
        </orb-button>
        <orb-menu>
          <orb-mi onclick="setTheme('system')">System</orb-mi>
          <orb-mi onclick="setTheme('light')">Light</orb-mi>
          <orb-mi checked onclick="setTheme('dark')">Dark</orb-mi>
        </orb-menu>
      </orb-popover>
    </orb-toolbar>
  </header>
  <nav data-landmark="sidebar" aria-label="Main navigation">
    <orb-tree id="main-nav-tree">
      <orb-ti href="/" label="Home"></orb-ti>
      <orb-ti label="Installation"></orb-ti>
      <orb-ti label="Tutorials" open>
        <orb-ti label="Forms"></orb-ti>
        <orb-ti label="Themes"></orb-ti>
        <orb-ti label="Data Tables"></orb-ti>
        <orb-ti label="Design Patterns"></orb-ti>
      </orb-ti>
      <orb-ti label="Components" open>
        {% for component in collections.componentsNav %}
          <orb-ti label="{{ component.data.sidebar_label or component.name }}" href="/components/{{ component.name }}/"></orb-ti>
        {% endfor %}
      </orb-ti>
      <orb-ti label="CSS Utilities" open>
        <orb-ti label="Design Tokens"></orb-ti>
        <orb-ti label="Classes"></orb-ti>
      </orb-ti>
    </orb-tree>
    <script type="module">
      await customElements.whenDefined('orb-tree')
      await customElements.whenDefined('orb-ti')
      const tree = document.querySelector('orb-tree#main-nav-tree')
      const branches = Array.from(tree.querySelectorAll('orb-ti'))
      const currentPath = window.location.href.replace(window.location.origin, '')
      const currentBranch = branches.find(b => b.href == currentPath)
      tree.value = currentBranch?.label
      requestAnimationFrame(() => currentBranch?.scrollIntoView({
        block: 'center',
        container: 'all'
      }))
    </script>
  </nav>
  <main>
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>
</body>

<script>
  function setTheme(theme) {
    const htmlEl = document.querySelector('html')
    localStorage.setItem('orb__theme', theme ?? 'system')
    htmlEl.classList.toggle('orb-theme-light', theme === 'light')
    htmlEl.classList.toggle('orb-theme-dark', theme === 'dark')
  }
  setTheme(localStorage.getItem('orb__theme'))
</script>

</html>
